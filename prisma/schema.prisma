// datasource e generator padrão do Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Tabela Usuarios
model Usuario {
  id           Int      @id @default(autoincrement()) @map("ID_Usuario")
  nomeCompleto String   @map("NomeCompleto")
  email        String   @unique @map("Email")
  senhaHash    String   @map("SenhaHash")
  dataCadastro DateTime @default(now()) @map("DataCadastro")

  cursos          Curso[]          @relation("InstrutorCursos")
  matriculas      Matricula[]
  progressoAulas  ProgressoAula[]
  avaliacoes      Avaliacao[]
  certificados    Certificado[]
  assinaturas     Assinatura[]

  @@map("Usuarios")
}

// 2. Tabela Categorias
model Categoria {
  id        Int     @id @default(autoincrement()) @map("ID_Categoria")
  nome      String  @unique @map("Nome")
  descricao String? @map("Descricao")

  cursos  Curso[]
  trilhas Trilha[]

  @@map("Categorias")
}

// 3. Tabela Cursos
model Curso {
  id             Int      @id @default(autoincrement()) @map("ID_Curso")
  titulo         String   @map("Titulo")
  descricao      String?  @map("Descricao")
  idInstrutor    Int      @map("ID_Instrutor")
  idCategoria    Int      @map("ID_Categoria")
  nivel          String   @map("Nivel")
  dataPublicacao DateTime @default(now()) @map("DataPublicacao")
  totalAulas     Int      @default(0) @map("TotalAulas")
  totalHoras     Float    @default(0) @map("TotalHoras")

  instrutor    Usuario        @relation("InstrutorCursos", fields: [idInstrutor], references: [id])
  categoria    Categoria      @relation(fields: [idCategoria], references: [id])
  modulos      Modulo[]
  matriculas   Matricula[]
  avaliacoes   Avaliacao[]
  trilhaCursos TrilhaCurso[]
  certificados Certificado[]

  @@map("Cursos")
}

// 4. Tabela Modulos
model Modulo {
  id      Int    @id @default(autoincrement()) @map("ID_Modulo")
  idCurso Int    @map("ID_Curso")
  titulo  String @map("Titulo")
  ordem   Int    @map("Ordem")

  curso Curso  @relation(fields: [idCurso], references: [id])
  aulas Aula[]

  @@map("Modulos")
}

// 5. Tabela Aulas
model Aula {
  id             Int    @id @default(autoincrement()) @map("ID_Aula")
  idModulo       Int    @map("ID_Modulo")
  titulo         String @map("Titulo")
  tipoConteudo   String @map("TipoConteudo")
  urlConteudo    String @map("URL_Conteudo")
  duracaoMinutos Int    @map("DuracaoMinutos")
  ordem          Int    @map("Ordem")

  modulo         Modulo          @relation(fields: [idModulo], references: [id])
  progressoAulas ProgressoAula[]

  @@map("Aulas")
}

// 6. Tabela Matriculas
model Matricula {
  id            Int       @id @default(autoincrement()) @map("ID_Matricula")
  idUsuario     Int       @map("ID_Usuario")
  idCurso       Int       @map("ID_Curso")
  dataMatricula DateTime  @default(now()) @map("DataMatricula")
  dataConclusao DateTime? @map("DataConclusao")

  usuario Usuario @relation(fields: [idUsuario], references: [id])
  curso   Curso   @relation(fields: [idCurso], references: [id])

  @@map("Matriculas")
}

// 7. Tabela Progresso_Aulas
model ProgressoAula {
  idUsuario     Int      @map("ID_Usuario")
  idAula        Int      @map("ID_Aula")
  dataConclusao DateTime @default(now()) @map("DataConclusao")
  status        String   @map("Status")

  usuario Usuario @relation(fields: [idUsuario], references: [id])
  aula    Aula    @relation(fields: [idAula], references: [id])

  @@id([idUsuario, idAula])
  @@map("Progresso_Aulas")
}

// 8. Tabela Avaliacoes
model Avaliacao {
  id           Int      @id @default(autoincrement()) @map("ID_Avaliacao")
  idUsuario    Int      @map("ID_Usuario")
  idCurso      Int      @map("ID_Curso")
  nota         Int      @map("Nota")
  comentario   String?  @map("Comentario")
  dataAvaliacao DateTime @default(now()) @map("DataAvaliacao")

  usuario Usuario @relation(fields: [idUsuario], references: [id])
  curso   Curso   @relation(fields: [idCurso], references: [id])

  @@map("Avaliacoes")
}

// 9. Tabela Trilhas
model Trilha {
  id          Int     @id @default(autoincrement()) @map("ID_Trilha")
  titulo      String  @map("Titulo")
  descricao   String? @map("Descricao")
  idCategoria Int     @map("ID_Categoria")

  categoria    Categoria     @relation(fields: [idCategoria], references: [id])
  trilhaCursos TrilhaCurso[]
  certificados Certificado[]

  @@map("Trilhas")
}

// 10. Tabela Trilhas_Cursos (Tabela Associativa)
model TrilhaCurso {
  idTrilha Int @map("ID_Trilha")
  idCurso  Int @map("ID_Curso")
  ordem    Int @map("Ordem")

  trilha Trilha @relation(fields: [idTrilha], references: [id])
  curso  Curso  @relation(fields: [idCurso], references: [id])

  @@id([idTrilha, idCurso])
  @@map("Trilhas_Cursos")
}

// 11. Tabela Certificados
model Certificado {
  id               Int      @id @default(autoincrement()) @map("ID_Certificado")
  idUsuario        Int      @map("ID_Usuario")
  idCurso          Int      @map("ID_Curso")
  idTrilha         Int?     @map("ID_Trilha")
  codigoVerificacao String   @unique @map("CodigoVerificacao")
  dataEmissao      DateTime @default(now()) @map("DataEmissao")

  usuario Usuario @relation(fields: [idUsuario], references: [id])
  curso   Curso   @relation(fields: [idCurso], references: [id])
  trilha  Trilha? @relation(fields: [idTrilha], references: [id])

  @@map("Certificados")
}

// 12. Tabela Planos
model Plano {
  id           Int     @id @default(autoincrement()) @map("ID_Plano")
  nome         String  @map("Nome")
  descricao    String? @map("Descricao")
  preco        Float   @map("Preco")
  duracaoMeses Int     @map("DuracaoMeses")

  assinaturas Assinatura[]

  @@map("Planos")
}

// 13. Tabela Assinaturas
model Assinatura {
  id         Int      @id @default(autoincrement()) @map("ID_Assinatura")
  idUsuario  Int      @map("ID_Usuario")
  idPlano    Int      @map("ID_Plano")
  dataInicio DateTime @map("DataInicio")
  dataFim    DateTime @map("DataFim")

  usuario    Usuario     @relation(fields: [idUsuario], references: [id])
  plano      Plano       @relation(fields: [idPlano], references: [id])
  pagamentos Pagamento[]

  @@map("Assinaturas")
}

// 14. Tabela Pagamentos
model Pagamento {
  id                 Int      @id @default(autoincrement()) @map("ID_Pagamento")
  idAssinatura       Int      @map("ID_Assinatura")
  valorPago          Float    @map("ValorPago")
  dataPagamento      DateTime @map("DataPagamento")
  metodoPagamento    String   @map("MetodoPagamento")
  idTransacaoGateway String   @map("Id_Transacao_Gateway")

  assinatura Assinatura @relation(fields: [idAssinatura], references: [id])

  @@map("Pagamentos")
}

